# Copie este arquivo para "docker.env.local" (esse nome já está no .gitignore, não é commitado)
# e preencha com os valores reais do seu projeto Supabase (Project Settings -> API).
# São os mesmos 4 valores que você já usa nas variáveis de ambiente do Render.

Supabase__Url=https://SEU-PROJETO.supabase.co
Supabase__AnonKey=SUA-CHAVE-ANON
Supabase__ServiceRoleKey=SUA-CHAVE-SERVICE-ROLE
Supabase__AdminBootstrapEmail=seu-email@dominio.com
